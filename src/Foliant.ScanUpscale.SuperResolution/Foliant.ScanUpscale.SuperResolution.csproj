<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ML super-resolution IScanUpscaler backend for Foliant (ONNX, runs fully local via ONNX Runtime; opt-in CUDA). Recovers text from low-resolution scanned pages in the retry role (ProcessingOptions.RetryLowResolutionPages): pages whose first OCR pass produced ~nothing are re-OCR'd on a Real-ESRGAN-upscaled raster. One-line setup via SuperResolutionScanUpscale.CreateDefaultAsync() — the BSD-3-Clause model downloads into the local cache with SHA-256 verification. GPU hosts additionally reference Microsoft.ML.OnnxRuntime.Gpu and set SuperResolutionOptions.UseCuda.</Description>
    <!-- Promoted from research backend in 1.6.0: the ADR-0004 retry-only role escapes the Gate 8
         always-on verdict (baseline is an empty page; keep-better makes recovery monotone).
         Gate ledger before release: SR-vs-classical on the 30-DPI retry corpus + Gate 8 + census. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foliant.Core\Foliant.Core.csproj" />
    <ProjectReference Include="..\Foliant.Models\Foliant.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Update="MinVer" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SkiaInterop.cs" Link="Internal\SkiaInterop.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Foliant.Tests" />
  </ItemGroup>

</Project>
