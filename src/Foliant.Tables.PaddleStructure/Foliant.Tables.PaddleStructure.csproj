<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PaddleStructure (SLANet-plus) table-structure backend for Foliant (ONNX, runs fully local via ONNX Runtime): purpose-built for raster/screenshot tables — emits HTML-style structure with row/column spans and per-cell boxes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foliant.Core\Foliant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SkiaInterop.cs" Link="Internal\SkiaInterop.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Foliant.Tests" />
  </ItemGroup>

</Project>
