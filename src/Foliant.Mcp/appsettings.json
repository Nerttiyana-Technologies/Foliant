{
  "//": "Dev defaults only — every key is overridable via env vars (the MCP client's `env` block).",
  "//example-claude-desktop": {
    "mcpServers": {
      "foliant": {
        "command": "foliant-mcp",
        "env": {
          "Foliant__ModelsDir": "/path/to/foliant/models",
          "Privacy__BlockSensitivePages": "false"
        }
      }
    }
  },
  "Foliant": {
    "ModelsDir": "",
    "TemplatesDbPath": "",
    "MaxPages": 2000,
    "UseZeroDepFastLane": true,
    "SummarySyncPageLimit": 10
  },
  "Privacy": {
    "BlockSensitivePages": false
  }
}
