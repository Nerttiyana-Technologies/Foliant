<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Quality-gate harness (RESULTS.md gates 1, 2, 4): runs the production pipeline over a
    local PDF corpus and emits a scorecard CSV + pass/fail summary.

    The corpus is NEVER committed (Test-Data/ and all PDFs are gitignored).
    Usage:  dotnet run -c Release -\- <pdf-dir> [output-dir] [-\-models <models-dir>]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Foliant.Pipeline\Foliant.Pipeline.csproj" />
    <!-- LiLT form-K-V model for the form-kv-eval Gate-3 scorer (local-only eval). -->
    <ProjectReference Include="..\..\src\Foliant.Forms.Lilt\Foliant.Forms.Lilt.csproj" />
    <!-- Template ingestion: the emit-form-template mode generates a FormLayout draft from a blank form. -->
    <ProjectReference Include="..\..\src\Foliant.Templates\Foliant.Templates.csproj" />
    <!-- ML super-resolution upscaler: A/B a Real-ESRGAN-class model on low-DPI scans (Gate 8). -->
    <ProjectReference Include="..\..\src\Foliant.ScanUpscale.SuperResolution\Foliant.ScanUpscale.SuperResolution.csproj" />
    <!-- ADR-0003 G1 routing census: the ZeroDep-first router (pulls ZeroDep via the orchestrator's package ref). -->
    <ProjectReference Include="..\..\src\Foliant.Orchestration\Foliant.Orchestration.csproj" />
    <!-- PdfPig: reads the page text-layer word order (order-aware gate) and the AcroForm field
         map + widget rects for the form-K-V harvester. -->
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <!-- SkiaSharp: encode the page PNG for the form-K-V records (matches the pipeline's version) -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

</Project>
